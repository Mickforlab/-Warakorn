rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'warakornmick1@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Evaluation config & profile (Public Read, Admin Write)
    match /evaluation_config/{configId} {
      allow read: if true;
      allow write: if isValidId(configId) && isAdmin();
    }

    // Evaluation categories & evidence (Public Read, Admin Write)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isValidId(categoryId) && isAdmin();
    }

    // Admin users management
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isValidId(adminId) && isAdmin();
    }

    // Health / connection test doc
    match /test/{docId} {
      allow read: if true;
    }
  }
}
